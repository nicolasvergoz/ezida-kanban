#!/usr/bin/env bash
# post-checkout hook: auto-links shared gitignored config (see
# scripts/lib/worktree-shared.sh) into a worktree the moment it's
# created, so plain `git worktree add` needs no extra step.
#
# `git worktree add` performs an implicit checkout of the new worktree,
# which fires this hook with $1 (previous HEAD) all zeros — a real branch
# switch always has a real previous SHA there. That's the only way to
# tell "this checkout just created a worktree" apart from an ordinary
# branch checkout, since git has no dedicated post-worktree-add hook.
# $3 (branch-checkout flag) is included for completeness; it's always 1
# in the worktree-creation case, so it isn't load-bearing on its own.
#
# Only fires at all if core.hooksPath points here — see
# scripts/worktree-add.sh, which configures that on first run.
set -euo pipefail

prev_head="${1:-}"
branch_checkout="${3:-0}"

if [ "$prev_head" != "0000000000000000000000000000000000000000" ] || [ "$branch_checkout" != "1" ]; then
  exit 0
fi

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../lib/worktree-shared.sh
source "$script_dir/lib/worktree-shared.sh"

wtshared::bootstrap
wtshared::link "$(pwd)"
